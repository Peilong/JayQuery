# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=jayquery
WANDB_ENTITY=etown-cs
# Set to "offline" if no internet access
WANDB_MODE=online

# PSI Server (default: localhost for single-machine simulation)
PSI_SERVER_HOST=localhost
PSI_SERVER_PORT=50051

# Flower Server
FL_SERVER_HOST=localhost
FL_SERVER_PORT=8080
FL_NUM_ROUNDS=50

# Data paths
OULAD_RAW_DIR=data/raw
OULAD_PROCESSED_DIR=data/processed
OULAD_MODULE=BBB_2013J

# Reproducibility
GLOBAL_SEED=42
